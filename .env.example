# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=powerbia
DATABASE_URL=postgres://powerbia:powerbia@localhost:5432/powerbia

# --- LLM --------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Any OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, vLLM, Ollama, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used by every pipeline stage. The MVP used gpt-4.1.
LLM_MODEL=gpt-4.1

# --- DAX gateway ------------------------------------------------------------
# From apps/api running on the host, the gateway is not published — run the API
# inside compose, or temporarily publish 8080, to use the XMLA path locally.
DAX_GATEWAY_URL=http://dax-gateway:8080
# Shared bearer token between apps/api and services/dax-gateway.
#   openssl rand -hex 32
DAX_GATEWAY_TOKEN=

# --- Secrets ----------------------------------------------------------------
# AES-256-GCM key encrypting each dataset's service-principal secret at rest.
# Exactly 64 hex chars (32 bytes):  openssl rand -hex 32
DATASET_SECRET_KEY=
# Signs session cookies:  openssl rand -hex 32
SESSION_COOKIE_SECRET=

# --- Introspection ----------------------------------------------------------
# On boot the API refreshes any dataset whose catalogue is missing or older than
# INTROSPECT_MAX_AGE_HOURS. It runs in the background and never blocks startup.
INTROSPECT_ON_STARTUP=true
INTROSPECT_MAX_AGE_HOURS=168

# --- Power BI (seeds the first dataset row) ---------------------------------
# The MVP scraped these out of a single PBI_CONNECTION_STRING with regexes.
# They are structured fields now; the secret is encrypted before it is stored.
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_NAME=
PBI_DATASET_NAME=
