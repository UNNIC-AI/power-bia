# Copy to .env and fill in. Never commit .env.
#
# Every variable the code reads is listed here. Those with a working default are
# shown commented out; uncomment one only to override it.

# --- Runtime ----------------------------------------------------------------
# development enables pretty logs and the debug level; production is JSON at info.
#NODE_ENV=development
# Port the API listens on.
#PORT=3000
# Origin the browser loads the app from. Drives CORS *and* the origin check on
# every mutation: a wrong value blocks every write while reads keep working.
#WEB_ORIGIN=http://localhost:5173
# Where the web dev server forwards /api, when it runs on the host.
#API_PROXY_TARGET=http://localhost:3000

# --- Compose ----------------------------------------------------------------
# Host-side ports the compose services publish. Change one when it is already
# taken, or to run a second instance alongside the first.
#POSTGRES_PORT=5432
#GATEWAY_PORT=8080
#API_PORT=3000
#WEB_PORT=5173
#
# Addresses a *container* uses, as opposed to the host-side ones below. They need
# their own names: compose interpolates this file into docker-compose.yml, so
# reusing DATABASE_URL there would always resolve to the host-side value and the
# compose-network default would never apply. Defaults reach the compose network;
# set one to point a container at a process running on the host.
#COMPOSE_DATABASE_URL=postgres://powerbia:powerbia@host.docker.internal:5432/powerbia
#COMPOSE_DAX_GATEWAY_URL=http://host.docker.internal:8080
#COMPOSE_API_PROXY_TARGET=http://host.docker.internal:3000

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=powerbia
DATABASE_URL=postgres://powerbia:powerbia@localhost:5432/powerbia

# --- LLM --------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Any OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, vLLM, Ollama, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used by every pipeline stage. The MVP used gpt-4.1.
LLM_MODEL=gpt-4.1

# --- DAX gateway ------------------------------------------------------------
# The compose gateway publishes 8080, so a host-run API reaches it at localhost.
# With the API inside compose too, this becomes http://dax-gateway:8080.
DAX_GATEWAY_URL=http://localhost:8080
# Shared bearer token between apps/api and services/dax-gateway.
#   openssl rand -hex 32
DAX_GATEWAY_TOKEN=

# --- Secrets ----------------------------------------------------------------
# AES-256-GCM key encrypting each dataset's service-principal secret at rest.
# Exactly 64 hex chars (32 bytes):  openssl rand -hex 32
DATASET_SECRET_KEY=
# Signs session cookies:  openssl rand -hex 32
SESSION_COOKIE_SECRET=

# --- Introspection ----------------------------------------------------------
# On boot the API refreshes any dataset whose catalogue is missing or older than
# INTROSPECT_MAX_AGE_HOURS. It runs in the background and never blocks startup.
INTROSPECT_ON_STARTUP=true
INTROSPECT_MAX_AGE_HOURS=168
# Language the assistant writes the model's own context in when it does so at
# boot, where there is no user to take a locale from. es | en
MODEL_CONTEXT_LOCALE=es

# --- Power BI ---------------------------------------------------------------
# THE ONLY PLACE THE POWER BI MODEL IS CHOSEN. The API reads these on every boot
# and writes them into the datasets row, secret encrypted; nothing in the UI can
# change them. To use a different model: edit these and restart. The row is
# reused (conversations and dashboards survive), the catalogue of the model left
# behind is dropped, and the new one is introspected in that same boot.
#
# Quote values containing spaces, or `set -a; . ./.env` breaks.
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_NAME=
PBI_DATASET_NAME=
# Optional display name for the UI. Defaults to PBI_DATASET_NAME.
PBI_MODEL_NAME=
