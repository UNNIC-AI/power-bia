{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"],
    // An app is a build target, not a consumable package: emitting declarations
    // would force us to name the AI SDK's internal stream types.
    "declaration": false,
    "declarationMap": false,
    "composite": false
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../packages/contracts" }, { "path": "../../packages/db" }]
}
